# Copy to .env.local (Supabase/site vars) and .env (DATABASE_URL — Prisma reads
# only .env, not .env.local) and fill in real values. See SETUP.md for how to get
# each one.

# --- Database (Prisma) — goes in .env ---
# Local dev: printed by `npx prisma dev`, or any local Postgres.
#
# DATABASE_URL is what the app uses at runtime (src/lib/prisma.ts). In production point it at the
# Supabase **transaction pooler** (Settings > Database > Connection string > "Transaction pooler",
# host *.pooler.supabase.com, port 6543): serverless instances open and drop connections constantly,
# and the transaction pooler shares a few real connections between all of them. Each instance keeps
# a pool of at most 5 (src/lib/prisma.ts).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"
#
# DIRECT_URL is used only by the Prisma CLI (prisma7.config.ts: migrate, db pull, studio), which needs
# a session connection: the direct connection or the session pooler (port 5432). Leave it unset and
# the CLI uses DATABASE_URL (fine locally, or while DATABASE_URL is itself a :5432 URL).
# DIRECT_URL="postgres://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth — goes in .env.local ---
# Settings > API in your Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL used to build OAuth/email-confirmation redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Staging only (Vercel > Settings > Environment Variables > Preview, branch "staging"):
# skips sign-in and treats every visitor as one shared test user so watchlist/baskets
# can be tested without auth. Ignored in production (VERCEL_ENV=production).
# STAGING_SKIP_LOGIN=1

# --- Company figures: automatic refresh (src/lib/financials/auto.ts) ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/financials/refresh (vercel.json,
# 19:00 IST weekdays), the backstop for the refresh that page views trigger. Set it in Vercel >
# Settings > Environment Variables for Production AND Preview (any long random string, e.g.
# `openssl rand -hex 32`). Unset, the route refuses every call (locally it stays unset).
# CRON_SECRET=
#
# The visit trigger (a page view schedules a refresh chunk once the figures are a trading day
# behind) is ON by default on Vercel production and preview (VERCEL_ENV) and OFF everywhere else, so
# dev servers and tests never write to the shared database. 1 = on anywhere (only to test the
# refresh deliberately), 0 = off everywhere, the cron route included.
# FINANCIALS_AUTO_REFRESH=0

# --- Razorpay (wired in step 4 — monetization) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Search Console, Bing and Google Analytics (src/lib/site.ts) — all optional ---
# Set in Vercel > Settings > Environment Variables for Production only. Unset renders nothing.
# GA4 measurement ID (Admin > Data streams > Web). Never loads on Vercel preview builds (staging).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Search Console "HTML tag" method: the content="..." value only. Not needed if the domain is
# verified by DNS (the Domain property, recommended).
# GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools meta-tag value (or import the site from Search Console instead).
# BING_SITE_VERIFICATION=

# Copy to .env.local (Supabase/site vars) and .env (DATABASE_URL — Prisma reads
# only .env, not .env.local) and fill in real values. See SETUP.md for how to get
# each one.

# --- Database (Prisma) — goes in .env ---
# Local dev: printed by `npx prisma dev` (already wired up for this session).
# Production: your Supabase project's Postgres connection string (Settings > Database
# > Connection string > "Transaction pooler", port 6543, with ?pgbouncer=true).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"

# --- Supabase Auth — goes in .env.local ---
# Settings > API in your Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL used to build OAuth/email-confirmation redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Razorpay (wired in step 4 — monetization) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

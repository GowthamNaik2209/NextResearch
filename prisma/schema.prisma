// NextResearch data model: users, watchlists and baskets, plus the company table (every listed
// company's figures). docs/ARCHITECTURE.md ("Database", "Company figures") describes it.
//
// Tables the code stopped using (FinancialStatementLine, PriceSnapshot, NewsLink, Subscription) and a
// few unused Company/KpiSnapshot columns are no longer modelled here but still exist in the database
// until prisma/proposed/2026-10-22_cleanup.sql is applied; Prisma ignores them. Company.role stays
// (NOT NULL with no database default, so inserts need it) until that file gives it a default.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Sectors, zones and 3D geometry are static authored content (three.js `build()`
// functions ported into src/lib/sector-content/products.ts) — not modeled here.
// Every company figure (price, valuation, ratios, FY revenue/profit) lives here and only here:
// the app reads it through src/lib/financials/load.ts and scripts/refresh-financials.ts writes it.
model Company {
  id             String              @id @default(cuid())
  ticker         String              @unique
  name           String
  listed         Boolean             @default(true)
  role           String
  // Trendlyne slug and stock id (the content's `tl` pair), used for the Trendlyne links.
  screenerSlug   String?
  externalId     String?
  // In the company table: the app shows this company's figures and the refresh keeps them current.
  // Rows from older seeds that are not (renamed tickers, unlisted names) stay false.
  tracked        Boolean             @default(false)
  // Company-level note on the figures (basis, fiscal-year convention, one-offs), shown with them in
  // every industry; a sector can add its own note on top. "standalone figures" here also tells the
  // refresh to read Screener's standalone page.
  financialsNote String?
  // Latest year dominated by a one-off (e.g. SPARC's FY26 voucher sale): kept out of the idea screens.
  screenOut      Boolean             @default(false)
  // BSE scrip code (e.g. "524715"): what BSE's corporate-announcements feed keys on. Read from the
  // company's Screener page (scripts/refresh-quarterly.ts); null for NSE-only listings.
  bseCode        String?
  financials     FinancialSnapshot[]
  quarterly      QuarterlyResult[]
  concallFilings ConcallFiling[]
  concalls       ConcallSummary[]
  guidance       ConcallGuidance[]
  digests        ConcallDigest[]
  kpis           KpiSnapshot[]
  watchlistedBy  Watchlist[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

// FY revenue/net profit, one row per year that has a value (supplier.f.rev/np, FY22-FY26).
model FinancialSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year        Int
  revenueCr   Decimal?
  netProfitCr Decimal?

  @@unique([companyId, year])
}

// Point-in-time KPI/price snapshot (matches the artifact's kpi tuple + mcap/price/range/cagr).
// The app shows each company's latest one; every refresh run adds one per company dated that day.
model KpiSnapshot {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asOf      DateTime
  price     Decimal?
  marketCap String?
  pe        Decimal?
  bookValue Decimal?
  divYield  Decimal?
  roce      Decimal?
  roe       Decimal?
  faceValue Decimal?
  low52w    Decimal?
  high52w   Decimal?
  cagr1y    Decimal?
  cagr3y    Decimal?
  cagr5y    Decimal?

  @@unique([companyId, asOf])
}

// One automatic refresh of the company table per NSE trading day (src/lib/financials/refresh.ts).
// A run writes each company's KpiSnapshot dated `snapshotDate` a chunk at a time; the app shows only
// snapshots dated on or before the latest PUBLISHED run, so a half-finished run is never visible and
// every company shares one date. `leaseUntil` lets one chunk at a time work on it, across instances.
enum FinancialsRunStatus {
  RUNNING
  PUBLISHED
  FAILED
}

model FinancialsRun {
  id           String              @id @default(cuid())
  // The IST trading day the figures are for, at UTC midnight (like KpiSnapshot.asOf).
  snapshotDate DateTime            @unique
  status       FinancialsRunStatus @default(RUNNING)
  // Tracked companies with a snapshot dated snapshotDate / in the table; tickers Screener could not read.
  done         Int                 @default(0)
  total        Int                 @default(0)
  failed       String[]            @default([])
  leaseUntil   DateTime?
  startedAt    DateTime            @default(now())
  publishedAt  DateTime?
}

// Mirrors a Supabase auth.users row (id = that user's UUID) for FK convenience.
model Profile {
  id        String      @id
  email     String      @unique
  createdAt DateTime    @default(now())
  watchlist Watchlist[]
  baskets   Basket[]
}

model Watchlist {
  id         String   @id @default(cuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceAtAdd Decimal
  addedAt    DateTime @default(now())

  @@unique([userId, companyId])
}

// A user's own basket of stocks: tracked and backtested, never traded. Industry baskets
// (every listed stock in a sector) are derived from the authored content and not stored;
// one copied from an industry keeps that sector in sourceSector to compare against.
// Shared baskets are readable by anyone with the link (id is an unguessable cuid).
enum BasketWeighting {
  EQUAL
  MCAP
}

model Basket {
  id              String          @id @default(cuid())
  userId          String
  user            Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  sourceSector    String?
  weighting       BasketWeighting @default(EQUAL)
  // Custom weighting: each item's own weight (BasketItem.weight). A flag rather than a new enum
  // value, so code that only knows EQUAL and MCAP still reads every row (it sees `weighting`).
  customWeighting Boolean         @default(false)
  isPublic        Boolean         @default(false)
  items           BasketItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
}

// Keyed by ticker rather than a Company FK: any listed ticker in the content can be added,
// whether or not the seed has a Company row for it. priceAtAdd is the live quote at the time.
model BasketItem {
  id         String   @id @default(cuid())
  basketId   String
  basket     Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  ticker     String
  priceAtAdd Decimal?
  // Custom weighting: the stock's target, % of the basket (the items total 100). Null otherwise.
  weight     Float?
  // The industry slug the stock was picked from (Add stocks > industry), or null (search, copy, older rows).
  pickedFrom String?
  addedAt    DateTime @default(now())

  @@unique([basketId, ticker])
}

// The price store: every mapped stock's and benchmark's daily bars for the last five years, topped up
// after each NSE trading day (src/lib/prices/refresh.ts), so baskets and charts read our own copy
// instead of fetching Yahoo on a visit (src/lib/prices/store.ts).
//
// One row per stock (its content ticker, e.g. "LT") or benchmark (its Yahoo symbol, e.g. "^NSEI").
model PriceSeries {
  key        String    @id
  // Where the bars come from: the Yahoo symbol that answered (e.g. "LT.NS", "EMBASSY-RR.NS"), or
  // "screener" (closes only, no open/high/low/volume) for a stock Yahoo has no prices for.
  source     String
  exchange   String    @default("NSE")
  // First and last day stored (IST trading days at UTC midnight), and the trading day last topped up to.
  firstDay   DateTime? @db.Date
  lastDay    DateTime? @db.Date
  checkedDay DateTime? @db.Date
  // A full five-year re-fetch (first fill, or old closes changed: a split Yahoo adjusted afterwards).
  fullAt     DateTime?
  updatedAt  DateTime  @updatedAt
}

model PriceBar {
  key    String
  day    DateTime @db.Date
  open   Float?
  high   Float?
  low    Float?
  close  Float
  volume Float?

  @@id([key, day])
}

// One top-up of the price store per NSE trading day; `leaseUntil` lets one chunk at a time work on
// it across instances. Readers don't look at it: each stock's bars are usable as soon as written.
model PriceRun {
  id         String    @id @default(cuid())
  day        DateTime  @unique @db.Date
  done       Int       @default(0)
  total      Int       @default(0)
  failed     String[]  @default([])
  finishedAt DateTime?
  leaseUntil DateTime?
  startedAt  DateTime  @default(now())
}

// ---------------------------------------------------------------------------------------------
// Quarterly results (src/lib/financials/quarterly.ts): Screener's quarterly table, one row per
// company per fiscal quarter, so management guidance on revenue, margin and profit can be checked
// against what was delivered. Upserted (Screener restates); FY = Indian fiscal year ending March,
// FY27 -> fiscalYear 2027, Q1 = Apr-Jun.
model QuarterlyResult {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear        Int
  quarter           Int
  periodEnd         DateTime @db.Date
  // "consolidated" | "standalone": the same basis rule as the annual figures.
  basis             String
  revenueCr         Decimal?
  expensesCr        Decimal?
  operatingProfitCr Decimal?
  opmPct            Decimal?
  otherIncomeCr     Decimal?
  depreciationCr    Decimal?
  interestCr        Decimal?
  pbtCr             Decimal?
  netProfitCr       Decimal?
  epsRs             Decimal?
  source            String   @default("screener")
  fetchedAt         DateTime @default(now())

  @@unique([companyId, fiscalYear, quarter])
}

// ---------------------------------------------------------------------------------------------
// Earnings calls (src/lib/concalls): every transcript filed on BSE/NSE for a tracked company since
// FY22, summarised by Claude. We keep our own summary, quotes of a few words with page numbers, and
// the link to the exchange filing; never the transcript itself. Append-only: the daily job adds
// filings as companies file them, the backfill fills the past (scripts/concall-backfill.ts).

// One row per transcript filing found. Status moves found -> fetched -> batched -> summarised, or
// stops at a failure status (scanned | not_transcript | download_failed | failed) with `error`.
model ConcallFiling {
  id         String          @id @default(cuid())
  companyId  String
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  exchange   String // "BSE" | "NSE"
  exchangeId String // BSE NEWSID / NSE seq_id: the dedupe key across runs
  url        String // the exchange attachment: the source link users see
  title      String
  filedAt    DateTime
  // The results quarter the call discussed (read from the transcript; null until summarised).
  fiscalYear Int?
  quarter    Int?
  pdfSha256  String?
  pages      Int?
  status     String          @default("found")
  error      String?
  // Batch API request this filing went out in (custom_id = filing id), while status = batched.
  batchId    String?
  attempts   Int             @default(0)
  summary    ConcallSummary?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([exchange, exchangeId])
  @@index([companyId, filedAt])
  @@index([status])
}

// Claude's summary of one call. `summary` holds the ConcallSummaryJson shape
// (src/lib/concalls/types.ts): demand, risks, initiatives, tone, key Q&A, each item with quote + page.
// Guidance is also split out into ConcallGuidance rows for the track record.
model ConcallSummary {
  id            String            @id @default(cuid())
  filingId      String            @unique
  filing        ConcallFiling     @relation(fields: [filingId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear    Int
  quarter       Int
  callDate      DateTime?         @db.Date
  tone          String // positive | cautiously positive | neutral | cautious | negative
  toneNote      String
  summary       Json
  checksPassed  Int // items whose quote and numbers were found in the PDF text
  checksTotal   Int
  model         String
  promptVersion String
  inputTokens   Int
  outputTokens  Int
  costUsd       Decimal
  guidance      ConcallGuidance[]
  createdAt     DateTime          @default(now())

  @@index([companyId, fiscalYear, quarter])
}

// One forward-looking statement from a call, with the period it is about, so it can be lined up
// against QuarterlyResult / FinancialSnapshot once that period has reported
// (src/lib/concalls/track-record.ts fills actual / verdict).
model ConcallGuidance {
  id               String         @id @default(cuid())
  summaryId        String
  summary          ConcallSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // GuidanceMetric in src/lib/concalls/types.ts (revenue_growth, ebitda_margin, capex, ...).
  metric           String
  // "FY" | "H1" | "H2" | "Q" | "multi_year" | "unspecified"
  periodKind       String
  targetFiscalYear Int?
  targetQuarter    Int?
  low              Decimal?
  high             Decimal?
  unit             String? // "%", "bps", "Rs cr", "$ mn", "x"
  direction        String? // "up" | "down" | "flat" when only directional
  statement        String
  quote            String
  page             Int
  // Filled by the track record once the target period has reported.
  actual           Decimal?
  actualNote       String?
  verdict          String? // beat | met | missed | pending | not_checkable
  checkedAt        DateTime?

  @@index([companyId, metric, targetFiscalYear])
}

// Multi-call digests for the company page: what management said over the last year or last few
// years, how guidance moved, how it compared with delivery. Regenerated when a new call lands.
// scope: "year" (last 4 calls) | "multi_year" (since FY22); one row per company per scope, replaced.
model ConcallDigest {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scope      String
  // The latest call it includes (fiscalYear * 10 + quarter), so it is rebuilt when a newer one lands.
  throughKey Int
  digest     Json
  model      String
  costUsd    Decimal
  updatedAt  DateTime @updatedAt

  @@unique([companyId, scope])
}

// Industry roll-ups per quarter from the sector's company summaries (sector-content slug).
model ConcallRollup {
  id         String   @id @default(cuid())
  sectorSlug String
  fiscalYear Int
  quarter    Int
  rollup     Json
  companies  String[]
  model      String
  costUsd    Decimal
  updatedAt  DateTime @updatedAt

  @@unique([sectorSlug, fiscalYear, quarter])
}

// One daily pass of the concall job (src/lib/concalls/daily.ts): discover the day's filings, fetch,
// submit a batch, collect finished batches. `leaseUntil`: one chunk at a time across instances.
model ConcallRun {
  id         String    @id @default(cuid())
  day        DateTime  @unique @db.Date
  found      Int       @default(0)
  batched    Int       @default(0)
  summarised Int       @default(0)
  failed     Int       @default(0)
  note       String?
  leaseUntil DateTime?
  finishedAt DateTime?
  startedAt  DateTime  @default(now())
}

// NextResearch data model.
// See /Users/gowtham/.claude/plans/breezy-booping-spindle.md for the design this implements.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Provenance label shown next to any financial/exposure figure so a demo number
// never passes as a live, verified one (product rule: never present unverified
// data as authoritative). Everything seeded from the original artifact today is
// DEMO; this is the seam a real data vendor flips to VERIFIED later per-company.
enum DataStatus {
  DEMO
  USER_GENERATED
  UNVERIFIED
  VERIFIED
  SOURCE_REQUIRED
}

// Sectors, zones and 3D geometry are static authored content (three.js `build()`
// functions ported into src/lib/sector-content/products.ts) — not modeled here.
// Every company figure (price, valuation, ratios, FY revenue/profit) lives here and only here:
// the app reads it through src/lib/financials/load.ts and scripts/refresh-financials.ts writes it.
// A Company's sectorSlugs mirrors which static sector(s) reference its ticker
// (set at seed time) so the company page can cross-link back to each ecosystem.
model Company {
  id             String                   @id @default(cuid())
  ticker         String                   @unique
  name           String
  listed         Boolean                  @default(true)
  role           String
  // Trendlyne slug and stock id (the content's `tl` pair), used for the Trendlyne links.
  screenerSlug   String?
  externalId     String?
  notes          String[]
  sectorSlugs    String[]                 @default([])
  dataStatus     DataStatus               @default(DEMO)
  // In the company table: the app shows this company's figures and the refresh keeps them current.
  // Rows from older seeds that are not (renamed tickers, unlisted names) stay false.
  tracked        Boolean                  @default(false)
  // Company-level note on the figures (basis, fiscal-year convention, one-offs), shown with them in
  // every industry; a sector can add its own note on top. "standalone figures" here also tells the
  // refresh to read Screener's standalone page.
  financialsNote String?
  // Latest year dominated by a one-off (e.g. SPARC's FY26 voucher sale): kept out of the idea screens.
  screenOut      Boolean                  @default(false)
  financials     FinancialSnapshot[]
  statementLines FinancialStatementLine[]
  prices         PriceSnapshot[]
  kpis           KpiSnapshot[]
  news           NewsLink[]
  watchlistedBy  Watchlist[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

// FY revenue/net profit, one row per year that has a value (supplier.f.rev/np, FY22-FY26).
model FinancialSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year        Int
  revenueCr   Decimal?
  netProfitCr Decimal?

  @@unique([companyId, year])
}

enum StatementType {
  INCOME
  BALANCE
  CASHFLOW
}

// Full income/balance/cash-flow line items, all years. Sparse (mostly empty) until
// a real data vendor is wired in — UI renders "—" for missing lineItem/year cells.
model FinancialStatementLine {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  statementType StatementType
  year          Int
  lineItem      String
  value         Decimal
  sortOrder     Int           @default(0)

  @@unique([companyId, statementType, year, lineItem])
}

// Price chart series. isEstimate flags seeded/sparse points so the UI can visibly
// mark them as not-real history rather than passing them off as a live feed.
model PriceSnapshot {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date       DateTime
  close      Decimal
  isEstimate Boolean  @default(false)

  @@unique([companyId, date])
}

// Point-in-time KPI/price snapshot (matches the artifact's kpi tuple + mcap/price/range/cagr).
// The app shows each company's latest one; every refresh run adds one per company dated that day.
// `note` is unused now (the company-level note is Company.financialsNote).
model KpiSnapshot {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asOf      DateTime
  price     Decimal?
  marketCap String?
  pe        Decimal?
  bookValue Decimal?
  divYield  Decimal?
  roce      Decimal?
  roe       Decimal?
  faceValue Decimal?
  low52w    Decimal?
  high52w   Decimal?
  cagr1y    Decimal?
  cagr3y    Decimal?
  cagr5y    Decimal?
  note      String?

  @@unique([companyId, asOf])
}

model NewsLink {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      String
  headline  String
  source    String
  url       String
}

// Mirrors a Supabase auth.users row (id = that user's UUID) for FK convenience.
model Profile {
  id           String        @id
  email        String        @unique
  createdAt    DateTime      @default(now())
  watchlist    Watchlist[]
  baskets      Basket[]
  subscription Subscription?
}

model Watchlist {
  id         String   @id @default(cuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceAtAdd Decimal
  addedAt    DateTime @default(now())

  @@unique([userId, companyId])
}

// A user's own basket of stocks: tracked and backtested, never traded. Industry baskets
// (every listed stock in a sector) are derived from the authored content and not stored;
// one copied from an industry keeps that sector in sourceSector to compare against.
// Shared baskets are readable by anyone with the link (id is an unguessable cuid).
enum BasketWeighting {
  EQUAL
  MCAP
}

model Basket {
  id              String          @id @default(cuid())
  userId          String
  user            Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  sourceSector    String?
  weighting       BasketWeighting @default(EQUAL)
  // Custom weighting: each item's own weight (BasketItem.weight). A flag rather than a new enum
  // value, so code that only knows EQUAL and MCAP still reads every row (it sees `weighting`).
  customWeighting Boolean         @default(false)
  isPublic        Boolean         @default(false)
  items           BasketItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
}

// Keyed by ticker rather than a Company FK: any listed ticker in the content can be added,
// whether or not the seed has a Company row for it. priceAtAdd is the live quote at the time.
model BasketItem {
  id         String   @id @default(cuid())
  basketId   String
  basket     Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  ticker     String
  priceAtAdd Decimal?
  // Custom weighting: the stock's target, % of the basket (the items total 100). Null otherwise.
  weight     Float?
  addedAt    DateTime @default(now())

  @@unique([basketId, ticker])
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  NONE
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  user                   Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpaySubscriptionId String?
  plan                   SubscriptionPlan   @default(FREE)
  status                 SubscriptionStatus @default(NONE)
  currentPeriodEnd       DateTime?
  updatedAt              DateTime           @updatedAt
}

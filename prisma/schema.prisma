// NextResearch data model: users, watchlists and baskets, plus the company table (every listed
// company's figures). docs/ARCHITECTURE.md ("Database", "Company figures") describes it.
//
// Tables the code stopped using (FinancialStatementLine, PriceSnapshot, NewsLink, Subscription) and a
// few unused Company/KpiSnapshot columns are no longer modelled here but still exist in the database
// until prisma/proposed/2026-10-22_cleanup.sql is applied; Prisma ignores them. Company.role stays
// (NOT NULL with no database default, so inserts need it) until that file gives it a default.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Sectors, zones and 3D geometry are static authored content (three.js `build()`
// functions ported into src/lib/sector-content/products.ts) — not modeled here.
// Every company figure (price, valuation, ratios, FY revenue/profit) lives here and only here:
// the app reads it through src/lib/financials/load.ts and scripts/refresh-financials.ts writes it.
model Company {
  id             String              @id @default(cuid())
  ticker         String              @unique
  name           String
  listed         Boolean             @default(true)
  role           String
  // Trendlyne slug and stock id (the content's `tl` pair), used for the Trendlyne links.
  screenerSlug   String?
  externalId     String?
  // In the company table: the app shows this company's figures and the refresh keeps them current.
  // Rows from older seeds that are not (renamed tickers, unlisted names) stay false.
  tracked        Boolean             @default(false)
  // Company-level note on the figures (basis, fiscal-year convention, one-offs), shown with them in
  // every industry; a sector can add its own note on top. "standalone figures" here also tells the
  // refresh to read Screener's standalone page.
  financialsNote String?
  // Latest year dominated by a one-off (e.g. SPARC's FY26 voucher sale): kept out of the idea screens.
  screenOut      Boolean             @default(false)
  financials     FinancialSnapshot[]
  kpis           KpiSnapshot[]
  shareholdings  Shareholding[]
  watchlistedBy  Watchlist[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

// FY revenue/net profit, one row per year that has a value (supplier.f.rev/np, FY22-FY26).
model FinancialSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year        Int
  revenueCr   Decimal?
  netProfitCr Decimal?

  @@unique([companyId, year])
}

// Point-in-time KPI/price snapshot (matches the artifact's kpi tuple + mcap/price/range/cagr).
// The app shows each company's latest one; every refresh run adds one per company dated that day.
model KpiSnapshot {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asOf      DateTime
  price     Decimal?
  marketCap String?
  pe        Decimal?
  bookValue Decimal?
  divYield  Decimal?
  roce      Decimal?
  roe       Decimal?
  faceValue Decimal?
  low52w    Decimal?
  high52w   Decimal?
  cagr1y    Decimal?
  cagr3y    Decimal?
  cagr5y    Decimal?

  @@unique([companyId, asOf])
}

// One automatic refresh of the company table per NSE trading day (src/lib/financials/refresh.ts).
// A run writes each company's KpiSnapshot dated `snapshotDate` a chunk at a time; the app shows only
// snapshots dated on or before the latest PUBLISHED run, so a half-finished run is never visible and
// every company shares one date. `leaseUntil` lets one chunk at a time work on it, across instances.
enum FinancialsRunStatus {
  RUNNING
  PUBLISHED
  FAILED
}

model FinancialsRun {
  id           String              @id @default(cuid())
  // The IST trading day the figures are for, at UTC midnight (like KpiSnapshot.asOf).
  snapshotDate DateTime            @unique
  status       FinancialsRunStatus @default(RUNNING)
  // Tracked companies with a snapshot dated snapshotDate / in the table; tickers Screener could not read.
  done         Int                 @default(0)
  total        Int                 @default(0)
  failed       String[]            @default([])
  leaseUntil   DateTime?
  startedAt    DateTime            @default(now())
  publishedAt  DateTime?
}

// Mirrors a Supabase auth.users row (id = that user's UUID) for FK convenience.
model Profile {
  id        String      @id
  email     String      @unique
  createdAt DateTime    @default(now())
  watchlist Watchlist[]
  baskets   Basket[]
}

model Watchlist {
  id         String   @id @default(cuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceAtAdd Decimal
  addedAt    DateTime @default(now())

  @@unique([userId, companyId])
}

// A user's own basket of stocks: tracked and backtested, never traded. Industry baskets
// (every listed stock in a sector) are derived from the authored content and not stored;
// one copied from an industry keeps that sector in sourceSector to compare against.
// Shared baskets are readable by anyone with the link (id is an unguessable cuid).
enum BasketWeighting {
  EQUAL
  MCAP
}

model Basket {
  id              String          @id @default(cuid())
  userId          String
  user            Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  sourceSector    String?
  weighting       BasketWeighting @default(EQUAL)
  // Custom weighting: each item's own weight (BasketItem.weight). A flag rather than a new enum
  // value, so code that only knows EQUAL and MCAP still reads every row (it sees `weighting`).
  customWeighting Boolean         @default(false)
  isPublic        Boolean         @default(false)
  items           BasketItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
}

// Keyed by ticker rather than a Company FK: any listed ticker in the content can be added,
// whether or not the seed has a Company row for it. priceAtAdd is the live quote at the time.
model BasketItem {
  id         String   @id @default(cuid())
  basketId   String
  basket     Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  ticker     String
  priceAtAdd Decimal?
  // Custom weighting: the stock's target, % of the basket (the items total 100). Null otherwise.
  weight     Float?
  // The industry slug the stock was picked from (Add stocks > industry), or null (search, copy, older rows).
  pickedFrom String?
  addedAt    DateTime @default(now())

  @@unique([basketId, ticker])
}

// The price store: every mapped stock's and benchmark's daily bars for the last five years, topped up
// after each NSE trading day (src/lib/prices/refresh.ts), so baskets and charts read our own copy
// instead of fetching Yahoo on a visit (src/lib/prices/store.ts).
//
// One row per stock (its content ticker, e.g. "LT") or benchmark (its Yahoo symbol, e.g. "^NSEI").
model PriceSeries {
  key         String    @id
  // Where the bars come from: the Yahoo symbol that answered (e.g. "LT.NS", "EMBASSY-RR.NS"), or
  // "screener" (closes only, no open/high/low/volume) for a stock Yahoo has no prices for.
  source      String
  exchange    String    @default("NSE")
  // First and last day stored (IST trading days at UTC midnight), and the trading day last topped up to.
  firstDay    DateTime? @db.Date
  lastDay     DateTime? @db.Date
  checkedDay  DateTime? @db.Date
  // A full five-year re-fetch (first fill, or old closes changed: a split Yahoo adjusted afterwards).
  fullAt      DateTime?
  updatedAt   DateTime  @updatedAt
}

model PriceBar {
  key    String
  day    DateTime @db.Date
  open   Float?
  high   Float?
  low    Float?
  close  Float
  volume Float?

  @@id([key, day])
}

// One top-up of the price store per NSE trading day; `leaseUntil` lets one chunk at a time work on
// it across instances. Readers don't look at it: each stock's bars are usable as soon as written.
model PriceRun {
  id         String    @id @default(cuid())
  day        DateTime  @unique @db.Date
  done       Int       @default(0)
  total      Int       @default(0)
  failed     String[]  @default([])
  finishedAt DateTime?
  leaseUntil DateTime?
  startedAt  DateTime  @default(now())
}

// Institutional money (the FII / DII view on /updates, src/lib/flows/). Every figure is published by an
// exchange or depository; none is per-stock daily flow, which nobody publishes.

// A company's shareholding pattern for one quarter (% of equity), as filed with the exchanges and read
// from Screener's quarterly table by the daily company refresh (src/lib/financials/refresh.ts). The
// only per-stock FII/DII figure that is public; it changes four times a year.
model Shareholding {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Quarter end (31 Mar / 30 Jun / 30 Sep / 31 Dec) at UTC midnight.
  quarter      DateTime @db.Date
  promoters    Float?
  fii          Float?
  dii          Float?
  government   Float?
  public       Float?
  others       Float?
  shareholders Int?
  updatedAt    DateTime @updatedAt

  @@unique([companyId, quarter])
}

// One NSE trading day of market-wide institutional activity: NSE's provisional FII/FPI and DII cash
// figures (NSE + BSE + MSEI, ₹ crore) and FII/DII index-futures open interest (contracts) from NSE's
// participant-wise OI file. The two arrive at different times, so either half can be missing.
model MarketFlowDay {
  day              DateTime @id @db.Date
  fiiBuyCr         Float?
  fiiSellCr        Float?
  fiiNetCr         Float?
  diiBuyCr         Float?
  diiSellCr        Float?
  diiNetCr         Float?
  fiiIdxFutLong    Int?
  fiiIdxFutShort   Int?
  diiIdxFutLong    Int?
  diiIdxFutShort   Int?
  // Official confirmed figures for days before NSE's provisional ones were collected (30 Oct 2026), by
  // trade date, ₹ crore net: NSDL's FPI equity bought and sold on the exchanges (from 2010), NSDL's DII
  // equity on the exchanges (from Jun 2026), and SEBI's mutual-fund equity (MFs only, a DII proxy).
  fpiNsdlNetCr     Float?
  diiNsdlNetCr     Float?
  mfSebiNetCr      Float?
  updatedAt        DateTime @updatedAt
}

// NSDL's fortnightly FPI equity investment by sector (BSE's 22-sector classification, ₹ crore).
model SectorFpiFlow {
  id          String   @id @default(cuid())
  // Last day of the fortnight (the 15th or month end) and NSDL's own label ("October 01-15, 2026").
  periodEnd   DateTime @db.Date
  periodLabel String
  sector      String
  netEquityCr Float
  aucEquityCr Float?

  @@unique([periodEnd, sector])
}

enum DealKind {
  BULK
  BLOCK
}

enum DealSide {
  BUY
  SELL
}

// NSE bulk deals (one client trading over 0.5% of a company's equity in a day) and block deals, as
// published, every listed symbol. A day's rows for one kind are replaced together, so a re-run never
// doubles them (two identical trades on one day are real and both kept).
model BulkDeal {
  id           String   @id @default(cuid())
  day          DateTime @db.Date
  kind         DealKind
  symbol       String
  securityName String
  clientName   String
  side         DealSide
  quantity     BigInt
  price        Float

  @@index([day])
  @@index([symbol, day])
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# auto-generated by `prisma init` (AI agent reference docs, not app code)
/.agents
/.windsurf
/.claude/skills
skills-lock.json

# local demo recordings (large; share out-of-band)
/demo/

# media engine: scripts, content plan and generated posts stay local, never on GitHub
/media/
scripts/.refresh-financials-report.json

# earnings-call prototype: downloaded transcripts, extracted text, cached summaries (local only)
/.concall-cache/
